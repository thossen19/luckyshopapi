}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  STORE_OWNER
  STORE_MANAGER
  STAFF
  CUSTOMER
}

enum ProductType {
  SIMPLE
  VARIABLE
  DIGITAL
  SUBSCRIPTION
  BUNDLE
  SERVICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeType {
  TEXT
  NUMBER
  COLOR
  SELECT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum InvoiceStatus {
  PENDING
  PAID
  VOID
  OVERDUE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
