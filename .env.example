# Environment
NODE_ENV=development
PORT=5000

# Database
# NOTE: if your MySQL host caps connections per user (e.g. Clever Cloud = 5),
# add ?connection_limit=2&pool_timeout=15 to keep Prisma within the limit.
DATABASE_URL="mysql://root:password@localhost:3306/aisaasecommerce"

# JWT
JWT_SECRET=dev-jwt-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
